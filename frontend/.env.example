# Strapi API address. The server root or the /api root both work.
# Leave empty (or set VITE_BACKEND=demo) to run in demo mode with data kept in the browser.
VITE_STRAPI_API_END_POINT=http://localhost:1337

# Set to "demo" to force demo mode even when VITE_STRAPI_API_END_POINT is set.
VITE_BACKEND=
